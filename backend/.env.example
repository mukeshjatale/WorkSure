# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
NODE_ENV=development
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=worksure_user
DB_PASSWORD=change_me
DB_NAME=worksure

# Long random text used to sign session cookies (generate one, see README)
SESSION_SECRET=replace_with_a_long_random_string
# Session lifetime in hours
SESSION_HOURS=8

# Where the website is opened from (used for CORS). Same as the backend URL when
# the backend serves the frontend (the default setup).
CLIENT_ORIGIN=http://localhost:5000
# Set to true only when behind a proxy that terminates HTTPS (Render, Railway, Nginx)
TRUST_PROXY=false

# Used ONLY by "npm run create-admin" (you can also type them when asked)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
